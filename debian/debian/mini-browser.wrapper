#!/bin/sh
# ──────────────────────────────────────────────────────────────────────
#  MiniBrowser — Dependency check & launch wrapper
# ──────────────────────────────────────────────────────────────────────
set -e

APP_NAME="MiniBrowser"
MAIN_SCRIPT="/usr/share/mini-browser/main.py"
PYTHON="python3"

# ANSI colour codes
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
BOLD='\033[1m'
NC='\033[0m' # No Colour

# ── Helper functions ──────────────────────────────────────────────────
info()   { printf "${CYAN}%s${NC}\n" "$*"; }
ok()     { printf "${GREEN}  ✓ %s${NC}\n" "$*"; }
warn()   { printf "${YELLOW}  ⚠ %s${NC}\n" "$*"; }
fail()   { printf "${RED}  ✗ %s${NC}\n" "$*"; }
heading(){ printf "\n${BOLD}%s${NC}\n" "$*"; }

# ── Check Python ──────────────────────────────────────────────────────
heading "🔍 Checking dependencies for ${APP_NAME}..."

if ! command -v "${PYTHON}" >/dev/null 2>&1; then
    fail "${PYTHON} is not installed."
    info ""
    info "  Install it with:"
    info "    sudo apt install python3"
    exit 1
fi
ok "Python 3 found: $(python3 --version 2>&1)"

# ── Check Python modules ──────────────────────────────────────────────
check_module() {
    if python3 -c "import $1" 2>/dev/null; then
        ok "Python module '$1' found"
    else
        fail "Python module '$1' is missing!"
        echo ""
        info "  Install the required Debian packages:"
        info "    sudo apt install python3-pyqt6 python3-pyqt6.qtwebengine"
        echo ""
        info "  Or install via pip (not recommended on system Python):"
        info "    pip install PyQt6 PyQt6-WebEngine"
        exit 1
    fi
}

check_module "PyQt6"
check_module "PyQt6.QtWebEngineWidgets"
check_module "sqlite3"

# ── Optional recommendation ───────────────────────────────────────────
heading "📦 Optional checks"

if python3 -c "import gettext; gettext.translation('mini-browser', '/usr/lib/mini-browser/locale', fallback=True)" 2>/dev/null; then
    ok "Translation files found"
else
    warn "Translation files not available — will use English"
fi

# ── Launch ────────────────────────────────────────────────────────────
heading "🚀 Launching ${APP_NAME}..."
echo ""
exec "${PYTHON}" "${MAIN_SCRIPT}" "$@"
